@model List<SupportTicket>
@{
    ViewData["Title"] = "Support";
}
<div class="d-flex justify-content-between align-items-center">
    <h2>Support tickets</h2>
    <a asp-action="Create" class="btn btn-primary">New ticket</a>
</div>
@if (Model.Count == 0)
{
    <p>No tickets yet.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Subject</th><th>Status</th><th>Updated</th><th></th></tr></thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Subject</td>
                <td><span class="badge bg-secondary">@t.TicketStatus</span></td>
                <td>@t.UpdatedUtc.ToString("yyyy-MM-dd")</td>
                <td><a asp-action="Details" asp-route-id="@t.SupportTicketId" class="btn btn-sm btn-outline-primary">Open</a></td>
            </tr>
        }
        </tbody>
    </table>
}
