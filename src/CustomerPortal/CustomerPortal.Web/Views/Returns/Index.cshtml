@model List<CustomerReturn>
@{
    ViewData["Title"] = "Returns";
}
<h2>Your returns</h2>
@if (Model.Count == 0)
{
    <p>No return requests yet.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Return #</th><th>Order</th><th>Status</th><th>Requested</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.ReturnNumber</td>
                <td>@r.OrderId</td>
                <td><span class="badge bg-secondary">@r.ReturnStatus</span></td>
                <td>@r.RequestedUtc.ToString("yyyy-MM-dd")</td>
            </tr>
        }
        </tbody>
    </table>
    <p class="text-muted">Returns are reviewed by our team, then received at the warehouse.</p>
}
