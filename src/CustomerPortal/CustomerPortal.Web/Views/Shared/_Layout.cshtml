<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RetailShop</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">RetailShop</a>
            <div class="navbar-nav me-auto">
                <a class="nav-link" asp-controller="Catalog" asp-action="Index">Shop</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" asp-controller="Cart" asp-action="Index">Cart</a>
                    <a class="nav-link" asp-controller="Orders" asp-action="Index">My Orders</a>
                    <a class="nav-link" asp-controller="Returns" asp-action="Index">Returns</a>
                    <a class="nav-link" asp-controller="Wishlist" asp-action="Index">Wishlist</a>
                    <a class="nav-link" asp-controller="Support" asp-action="Index">Support</a>
                }
            </div>
            <div class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" asp-controller="Profile" asp-action="Index">@User.Identity!.Name</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light mt-1">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
                }
            </div>
        </div>
    </nav>
    <div class="container">
        @if (TempData["Message"] is string msg && !string.IsNullOrEmpty(msg))
        {
            <div class="alert alert-info">@msg</div>
        }
        @RenderBody()
    </div>
    <footer class="container text-muted mt-5 mb-3"><hr/>LegacyRetailPortfolio &mdash; CustomerPortal (demo)</footer>
</body>
</html>
