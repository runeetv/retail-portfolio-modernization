@model List<OrderDesk.Domain.ReturnRequest>
@{
    ViewData["Title"] = "Returns review";
}
<h1>Returns review</h1>
<table>
    <thead><tr><th>Return</th><th>Order</th><th>Status</th><th>Requested</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.ReturnNumber</td>
            <td>@r.OrderId</td>
            <td>@r.ReturnStatus</td>
            <td>@r.RequestedUtc.ToString("yyyy-MM-dd")</td>
            <td>
                @if (r.ReturnStatus == "Requested")
                {
                    <form class="inline" method="post" asp-action="Review" asp-route-id="@r.ReturnId">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="approve" value="true" />
                        <button class="btn" type="submit">Approve</button>
                    </form>
                    <form class="inline" method="post" asp-action="Review" asp-route-id="@r.ReturnId">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="approve" value="false" />
                        <button class="btn secondary" type="submit">Reject</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
