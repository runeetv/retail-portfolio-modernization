@model List<CustomerPortal.Domain.SupportTicket>
@{
    ViewData["Title"] = "Support";
}
<h1>Support tickets</h1>
<p><a class="btn" asp-action="Create">New ticket</a></p>
@if (Model.Count == 0) { <p>No tickets.</p> }
else
{
    <table>
        <thead><tr><th>Subject</th><th>Status</th><th>Updated</th><th></th></tr></thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr><td>@t.Subject</td><td>@t.TicketStatus</td><td>@t.UpdatedUtc.ToString("g")</td><td><a asp-action="Details" asp-route-id="@t.SupportTicketId">Open</a></td></tr>
        }
        </tbody>
    </table>
}
