@{
    ViewData["Title"] = "Sign in";
}
<h1>Customer sign in</h1>
<div class="card" style="max-width:420px">
    <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
        @Html.AntiForgeryToken()
        <p><label>Username<br /><input name="username" required /></label></p>
        <p><label>Password<br /><input name="password" type="password" required /></label></p>
        <button class="btn" type="submit">Sign in</button>
    </form>
</div>
<p><a asp-action="Staff">Staff / warehouse sign in</a></p>
