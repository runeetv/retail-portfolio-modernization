@model CustomerPortal.Domain.CatalogProduct
@{
    ViewData["Title"] = Model.Name;
}
<h1>@Model.Name</h1>
<div class="card">
    <p><strong>SKU:</strong> @Model.Sku</p>
    <p><strong>Price:</strong> @Model.UnitPrice.ToString("C")</p>
    <p><strong>Category:</strong> @Model.Category?.Name</p>
    <p><strong>Displayed availability:</strong> @ViewBag.Available (re-checked at checkout)</p>
    <form class="inline" method="post" asp-controller="Cart" asp-action="Add">
        @Html.AntiForgeryToken()
        <input type="hidden" name="productId" value="@Model.ProductId" />
        <input name="quantity" type="number" value="1" min="1" style="width:70px" />
        <button class="btn" type="submit">Add to cart</button>
    </form>
    <form class="inline" method="post" asp-controller="Wishlist" asp-action="Add">
        @Html.AntiForgeryToken()
        <input type="hidden" name="productId" value="@Model.ProductId" />
        <button class="btn secondary" type="submit">Add to wishlist</button>
    </form>
</div>
