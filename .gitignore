## ------------------------------------------------------------------
## Secrets & local configuration — NEVER commit real credentials
## ------------------------------------------------------------------
# Local environment / secret files
*.env
.env.*
secrets.json
appsettings.*.local.json
appsettings.Local.json
# User-specific / machine-specific overrides
appsettings.Development.local.json
# Certificates and keys
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
# ASP.NET Core user secrets are stored outside the repo by default, but ignore any local copy:
**/UserSecrets/

## Databases / local data (never commit a provisioned DB file)
*.mdf
*.ldf
*.ndf
*.sqlite
*.db

## OS
.DS_Store
Thumbs.db
desktop.ini

## Project-specific scratch
_yamlcheck/
